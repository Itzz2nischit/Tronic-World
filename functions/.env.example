# Recipient admin email for Tronic World low-stock alerts
ALERT_RECIPIENT_EMAIL="itzz.nischit@gmail.com"

# Stock threshold below which the alert email is sent
LOW_STOCK_THRESHOLD="5"

# Outbound SMTP settings (e.g., Gmail SMTP using an App Password stored in Secret Manager)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-sender-email@gmail.com"
SMTP_FROM="Tronic World Alerts <your-sender-email@gmail.com>"

# Set the SMTP password as a Firebase Secret before deploying:
# firebase functions:secrets:set SMTP_PASS
